# Python
__pycache__/
*.pyc
*.egg-info/
.venv/
venv/

# Test + tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Practice output. `scripts/run_practice.py` writes here every run; nothing
# in it is submitted and nothing in it should ever be committed.
runs/

# Instructor-only phase material. NEVER present in this bundle, and never
# committed if it ever lands here: it is how the scored round stays scored.
phases/private/

# API credentials for the `--model real` path (ARENA_API_KEY & friends).
# `.env.example` is the committed template; `.env` holds the real key and
# must never leave this machine — `git add -A` would otherwise sweep it up.
.env
.env.*
!.env.example

# macOS
.DS_Store
