# Bản mẫu cho đường chạy `--model real`. Chép thành `.env` rồi điền key:
#
#     cp .env.example .env
#     python scripts/run_real.py --brief pub-08-an-toan-boc-do --out runs/real-pub08.json
#
# `.env` bị .gitignore chặn; file MẪU này thì không có bí mật nào nên commit
# được. `arena/model.py` đọc đúng ba tên biến dưới đây (KHÔNG phải
# OPENAI_API_KEY) và sẽ báo lỗi rõ ràng nếu thiếu — nó không bao giờ âm thầm
# quay về đường chạy offline.

ARENA_BASE_URL=https://api.openai.com/v1
ARENA_API_KEY=sk-thay-bang-key-that
ARENA_MODEL=gpt-4.1-mini
